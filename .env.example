# Chave da API transacional do Brevo. Fica somente no servidor, nunca no client.
# Painel do Brevo: SMTP & API > API Keys > Generate a new API key
BREVO_API_KEY=

# Remetente verificado no Brevo (Senders, Domains & Dedicated IPs > Senders)
BREVO_SENDER_EMAIL=contato@seudominio.com.br
BREVO_SENDER_NAME=Mentoria

# Para onde o CTA "Conhecer o Mentoria" leva, na tela e no e-mail
MENTORIA_URL=https://mentoria.com.br
